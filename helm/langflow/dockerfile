# Build custom Langflow image with Oracle dependencies
FROM langflowai/langflow:1.9.2

# Install system dependencies for Docling document processing
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*
USER 1000

# Install additional Python packages including Docling
#
# TLS-inspecting proxies (e.g. a corporate network) re-sign PyPI traffic with
# their own root CA, which pip's bundled certifi store does not trust. When the
# build passes a corp_ca secret, append it to certifi's bundle for this layer
# only -- the secret is never written into the image, so the runtime image does
# not inherit trust in that CA. Without the secret the install behaves as before.
RUN --mount=type=secret,id=corp_ca,target=/tmp/corp-ca.crt,uid=1000,required=false \
    set -eu; \
    if [ -s /tmp/corp-ca.crt ]; then \
      if certifi_pem=$(python -m certifi 2>/dev/null); then \
        cat "${certifi_pem}" /tmp/corp-ca.crt > /tmp/pip-ca-bundle.crt; \
      else \
        cp /tmp/corp-ca.crt /tmp/pip-ca-bundle.crt; \
      fi; \
      export PIP_CERT=/tmp/pip-ca-bundle.crt; \
      echo "Using proxy-aware CA bundle for pip: ${PIP_CERT}"; \
    fi; \
    pip install --no-cache-dir \
      "oracledb>=2.0.0" \
      "sentence-transformers>=2.2.0"; \
    rm -f /tmp/pip-ca-bundle.crt

USER root
RUN python - <<'PY'
from pathlib import Path

assets_root = Path("/app/.venv/lib/python3.12/site-packages/langflow/frontend/assets")
needle = '},100)};r.addEventListener("change",l),document.addEventListener("focus",c)'
replacement = '},3000)};r.addEventListener("change",l),document.addEventListener("focus",c)'

patched = False
for asset in assets_root.glob("index-*.js"):
    text = asset.read_text()
    if needle in text:
        asset.write_text(text.replace(needle, replacement, 1))
        patched = True
        break

if not patched:
    raise RuntimeError("Langflow frontend file picker focus timeout patch target was not found")
PY
USER 1000

# Set environment variable for max file upload size (100MB)
ENV LANGFLOW_MAX_FILE_SIZE_UPLOAD=100

CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0"]
